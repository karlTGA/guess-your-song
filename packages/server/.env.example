# Copy this file to .env and fill in the values.
# Loaded automatically by `yarn dev` and `yarn start` (via Node's --env-file).

# AcoustID API key for audio fingerprint lookup.
# Register a free key at https://acoustid.org/new-application
ACOUSTID_API_KEY=

# Optional overrides — uncomment to set.
# MONGO_URI=mongodb://localhost:27017/guess-your-song
# JWT_SECRET=change-me-in-production
# UPLOAD_DIR=./uploads
# PORT=3000
